{
  "name": "this.dom",
  "version": "1.0.97",
  "description": "A structured data formatter for the DOM.",
  "main": "./dist/dom.cjs",
  "module": "./dist/dom.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/dom.es.js",
      "import": "./dist/dom.es.js",
      "require": "./dist/dom.cjs"
    }
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc --options docs/typedoc.json",
    "test": "test"
  },
  "keywords": [
    "DOM",
    "data",
    "formatter"
  ],
  "bugs": {
    "url": "https://github.com/neurons-me/this.DOM/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurons-me/this.DOM.git"
  },
  "homepage": "https://www.npmjs.com/package/this.dom",
  "docs": "https://suiGn.github.io/this.DOM",
  "type": "module",
  "author": "suiGN",
  "license": "MIT",
  "repoType": "NPM Package",
  "category": "dataformatter",
  "files": [
    "dist"
  ],
  "dependencies": {
    "linkedom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typedoc": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-dts": "latest"
  }
}
