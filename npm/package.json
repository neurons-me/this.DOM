{
  "name": "this.dom",
  "version": "1.0.97",
  "description": "A structured data formatter for the DOM.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "docs:api": "typedoc --options docs/typedoc.json",
    "test": "test"
  },
  "keywords": [
    "DOM",
    "data",
    "formatter"
  ],
  "bugs": {
    "url": "https://github.com/neurons-me/this.DOM/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurons-me/this.DOM.git"
  },
  "homepage": "https://www.npmjs.com/package/this.dom",
  "docs": "https://suiGn.github.io/this.DOM",
  "type": "module",
  "author": "suiGN",
  "license": "MIT",
  "repoType": "NPM Package",
  "category": "dataformatter",
  "files": [
    "dist"
  ],
  "dependencies": {
    "linkedom": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "typedoc": "latest"
  }
}
